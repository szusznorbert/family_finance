{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "documents:reconcile": "jiti src/reconcile-documents.ts",
    "worker:recurring": "jiti src/recurring-worker.ts",
    "worker:recurring:verify": "jiti src/verify-recurring-rule.ts",
    "auth:schema": "auth generate --config ./src/lib/auth.ts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.12",
    "@household-finance/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.12",
    "busboy": "1.6.0",
    "dotenv": "^18.0.9",
    "jiti": "2.7.0",
    "next": "16.4.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "auth": "1.7.12",
    "prisma": "7.10.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
