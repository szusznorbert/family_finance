POSTGRES_USER=family_finance
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=family_finance

# Used by the API once it is scaffolded.
DATABASE_URL=postgresql://family_finance:change-this-local-password@localhost:5432/family_finance?schema=public

# Generate a high-entropy secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-this-with-a-generated-secret-of-at-least-32-characters
WEB_ORIGIN=http://localhost:3000
# Phone access: set WEB_ORIGIN to the exact origin used on the phone before starting
# the Compose API, for example http://192.168.1.20:3000. Use one origin at a time.

# scripts/dev.sh starts the Compose API, which owns the private document_data volume.
# A host API may use a different root only with a separate development database.
